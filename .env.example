# SERVER credentials only. Never use VITE_ prefixes for these values.
# Local: copy to .env and set KHUSHRANG_ENV_FILE to its absolute path when starting PHP.
# Hostinger: put .env OUTSIDE public_html at ~/domains/YOUR_DOMAIN/khushrang-private/.env.
# Use single quotes for literal passwords containing #, $, backslashes, spaces, or double quotes.
# Single-quoted values are literal; interpolation such as ${OTHER_VARIABLE} is not supported.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_HOSTINGER_DATABASE_NAME
DB_USER=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD='REPLACE_WITH_YOUR_DATABASE_PASSWORD'

# Absolute filesystem path, NOT a URL. Keep this outside public_html and panel deployments.
STORAGE_PATH=/home/YOUR_HOSTINGER_USER/domains/YOUR_DOMAIN/khushrang-private/media
